{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "bindings": [
        {
          "type": "service",
          "service": "valoraa",
          "format": "url",
          "env": "VALORAA_URL"
        }
      ]
    },
    "valoraa": {
      "root": "ValoraA",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
